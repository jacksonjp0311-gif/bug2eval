{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jacksonjp0311-gif/bug2eval/main/schemas/case.schema.json",
  "title": "Bug2Eval Case",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "title",
    "created_at",
    "source",
    "verification",
    "expected",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^/\\\\:\\s]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "argv",
        "timeout_sec"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "timeout_sec": {
          "type": "integer",
          "minimum": 1
        },
        "protected_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Additional workspace-relative verifier files/directories, identical in both snapshots and immutable during a run. Paths extend inferred protection."
        }
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "before",
        "after",
        "verify_exit_code"
      ],
      "properties": {
        "before": {
          "const": "fail"
        },
        "after": {
          "const": "pass"
        },
        "verify_exit_code": {
          "const": 0
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "before",
        "after",
        "prompt"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative slash-separated path within the case root; no parent traversal, absolute paths, backslashes, or symlinks escaping the case."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
